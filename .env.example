# Contact form delivery (see README → "Contact form").
#
# Leave VITE_BACKEND_URL empty to use Netlify Forms when deployed on Netlify
# (or a pre-filled email everywhere else). Set it only if you deploy the
# optional Express + Nodemailer API in /backend, e.g.:
#   VITE_BACKEND_URL=https://your-backend.example.com
VITE_BACKEND_URL=
